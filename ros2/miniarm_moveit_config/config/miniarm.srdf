<?xml version="1.0"?>
<robot name="miniarm">
  <!-- Model-only configuration. A fixed world root is not a measured L70 mount. -->
  <group name="miniarm_arm">
    <chain base_link="miniarm_base" tip_link="miniarm_gripper_link"/>
  </group>
  <group name="hand">
    <joint name="miniarm_gripper_joint"/>
    <link name="miniarm_right_knuckle_link"/>
    <link name="miniarm_left_bottom_knuckle_link"/>
    <link name="miniarm_right_bottom_knuckle_link"/>
    <link name="miniarm_left_inner_knuckle_link"/>
    <link name="miniarm_right_inner_knuckle_link"/>
    <link name="miniarm_left_inner_bottom_knuckle_link"/>
    <link name="miniarm_right_inner_bottom_knuckle_link"/>
    <link name="miniarm_left_finger_link"/>
    <link name="miniarm_right_finger_link"/>
  </group>
  <!-- Numeric reference pose only; not certified collision-free or a hardware home. -->
  <group_state group="miniarm_arm" name="zero">
    <joint name="miniarm_joint1" value="0"/>
    <joint name="miniarm_joint2" value="0"/>
    <joint name="miniarm_joint3" value="0"/>
    <joint name="miniarm_joint4" value="0"/>
    <joint name="miniarm_joint5" value="0"/>
    <joint name="miniarm_gripper_link_joint" value="0"/>
  </group_state>
  <end_effector group="hand" name="hand" parent_group="miniarm_arm" parent_link="miniarm_gripper_link"/>
  <virtual_joint child_link="miniarm_electronics" name="virtual_joint" parent_frame="world" type="fixed"/>
  <!-- Only structural adjacency exclusions; the old unverified 'Never' pairs are removed. -->
  <disable_collisions link1="miniarm_electronics" link2="miniarm_base" reason="Adjacent"/>
  <disable_collisions link1="miniarm_base" link2="miniarm_link1" reason="Adjacent"/>
  <disable_collisions link1="miniarm_link1" link2="miniarm_link2" reason="Adjacent"/>
  <disable_collisions link1="miniarm_link2" link2="miniarm_link3" reason="Adjacent"/>
  <disable_collisions link1="miniarm_link3" link2="miniarm_link4" reason="Adjacent"/>
  <disable_collisions link1="miniarm_link4" link2="miniarm_link5" reason="Adjacent"/>
  <disable_collisions link1="miniarm_link5" link2="miniarm_gripper_link" reason="Adjacent"/>
  <disable_collisions link1="miniarm_gripper_link" link2="miniarm_left_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="miniarm_gripper_link" link2="miniarm_right_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="miniarm_gripper_link" link2="miniarm_left_bottom_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="miniarm_gripper_link" link2="miniarm_right_bottom_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="miniarm_gripper_link" link2="miniarm_left_inner_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="miniarm_gripper_link" link2="miniarm_right_inner_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="miniarm_gripper_link" link2="miniarm_left_inner_bottom_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="miniarm_gripper_link" link2="miniarm_right_inner_bottom_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="miniarm_left_knuckle_link" link2="miniarm_left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="miniarm_right_knuckle_link" link2="miniarm_right_finger_link" reason="Adjacent"/>
</robot>
